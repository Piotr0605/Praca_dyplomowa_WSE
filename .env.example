# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# --- Baza danych ---
POSTGRES_USER=finanse
POSTGRES_PASSWORD=zmien_mnie
POSTGRES_DB=finanse
# Port bazy widoczny na Twoim komputerze (DBeaver, psql). Wewnątrz Dockera zawsze 5432.
DB_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://finanse:zmien_mnie@db:5432/finanse

# --- Backend ---
# Port API widoczny na Twoim komputerze. Musi zgadzać się z portem w VITE_API_URL.
BACKEND_HOST_PORT=8000

# --- Uwierzytelnianie ---
# Puste: backend wygeneruje losowy klucz przy pierwszym uruchomieniu i zapisze go poza repozytorium.
# Własny klucz (min. 32 znaki) można wygenerować poleceniem: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Moduł AI ---
# openai | anthropic | mock (mock = bez kosztów i internetu, do developmentu, testów i pokazu)
AI_PROVIDER=mock
OPENAI_API_KEY=
# Puste pole modelu oznacza model domyślny (OpenAI: gpt-5-mini, Anthropic: claude-haiku-5-5).
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Dzienny limit wygenerowanych porad na użytkownika; odpowiedź z cache się nie liczy.
ADVICE_DAILY_LIMIT=10

# --- Frontend ---
VITE_API_URL=http://localhost:8000
