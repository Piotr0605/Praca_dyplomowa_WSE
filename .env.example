# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# --- Baza danych ---
POSTGRES_USER=finanse
POSTGRES_PASSWORD=zmien_mnie
POSTGRES_DB=finanse
# Port bazy widoczny na Twoim komputerze (DBeaver, psql). Wewnątrz Dockera zawsze 5432.
DB_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://finanse:zmien_mnie@db:5432/finanse

# --- Uwierzytelnianie ---
JWT_SECRET_KEY=wygeneruj_np_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Moduł AI ---
# openai | anthropic | mock (mock = bez kosztów, do developmentu i testów)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
